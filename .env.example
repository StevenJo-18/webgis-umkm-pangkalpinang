# =========================================================
# KONFIGURASI DATABASE EXPRESS.JS (MYSQL 8.0)
# =========================================================
DB_DRIVER="mysql"
DB_STRICT="true"

# Konfigurasi MySQL 8.0 (digunakan saat DB_DRIVER=mysql)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="db_webgis_umkm_pangkalpinang"

# Lokasi file SQLite lokal (digunakan saat DB_DRIVER=sqlite)
SQLITE_PATH="./data/umkm_pangkalpinang.db"

# Kunci rahasia acak minimal 32 karakter untuk sesi login/register
# Generate di PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET="GANTI_DENGAN_NILAI_ACAK_MINIMAL_32_KARAKTER"
